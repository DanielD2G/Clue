<?xml version="1.0" encoding="utf-8"?>
<!-- CLUE: PC card for the launcher carousel. CoverCarousel sets its size and rounded clip. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="228dp"
    android:layout_height="320dp"
    android:background="@drawable/launcher_pc_card">

    <ImageView
        android:id="@+id/grid_image"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_gravity="center"
        android:layout_marginBottom="32dp"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/grid_overlay"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:layout_marginBottom="42dp"
        android:importantForAccessibility="no" />

    <ProgressBar
        android:id="@+id/grid_spinner"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:layout_marginBottom="42dp"
        android:indeterminate="true" />

    <TextView
        android:id="@+id/grid_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:padding="18dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/clue_launcher_text"
        android:textSize="20sp"
        android:fontFamily="sans-serif-medium" />
</FrameLayout>
