<?xml version="1.0" encoding="utf-8"?>
<!-- CLUE: bitrate tuner progress screen, in the console launcher look -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/launcher_bg_default">

    <include layout="@layout/clue_screen_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingStart="@dimen/clue_launcher_edge"
        android:paddingEnd="@dimen/clue_launcher_edge"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:baselineAligned="false">

        <!-- Left: what is happening -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="32dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tuner_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tuner_status_preparing"
                android:textColor="@color/clue_launcher_text"
                android:textSize="30sp"
                android:fontFamily="sans-serif-medium" />

            <ProgressBar
                android:id="@+id/tuner_progress"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/clue_accent" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:maxWidth="560dp"
                android:text="@string/tuner_intro"
                android:textColor="@color/clue_launcher_text_dim"
                android:textSize="17sp" />
        </LinearLayout>

        <!-- Right: one row per step -->
        <ScrollView
            android:id="@+id/tuner_steps_scroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fadingEdgeLength="24dp"
            android:requiresFadingEdge="vertical">

            <LinearLayout
                android:id="@+id/tuner_steps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>
