<?xml version="1.0" encoding="utf-8"?>
<!-- CLUE: console-style settings: top bar, category column on the left, rows on the right -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/launcher_bg_default"
    tools:context=".preferences.StreamSettings">

    <include layout="@layout/clue_screen_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ScrollView
            android:id="@+id/settings_nav_scroll"
            android:layout_width="340dp"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:paddingStart="36dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/settings_nav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <FrameLayout
            android:id="@+id/stream_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
