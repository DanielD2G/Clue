<?xml version="1.0" encoding="utf-8"?>
<!-- CLUE: console-style "add PC" screen. Upstream ids are kept. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/launcher_bg_default"
    tools:context=".preferences.AddComputerManually">

    <include layout="@layout/clue_screen_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingTop="56dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/ic_computer"
            android:tint="@color/clue_launcher_text"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/manuallyAddPcText"
            android:text="@string/title_add_pc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:preferKeepClear="true"
            android:textColor="@color/clue_launcher_text"
            android:textSize="28sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxWidth="560dp"
            android:gravity="center"
            android:text="@string/launcher_add_pc_help"
            android:textColor="@color/clue_launcher_text_dim"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:maxWidth="720dp"
            android:gravity="center"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/hostTextView"
                style="@style/ClueTextField"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxWidth="560dp"
                android:singleLine="true"
                android:preferKeepClear="true"
                android:inputType="textNoSuggestions"
                android:hint="@string/ip_hint"
                android:nextFocusRight="@+id/addPcButton"
                android:nextFocusDown="@+id/addPcButton">

                <requestFocus />
            </EditText>

            <Button
                android:id="@+id/addPcButton"
                style="@style/CluePrimaryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:preferKeepClear="true"
                android:text="@string/launcher_add_pc_button" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
